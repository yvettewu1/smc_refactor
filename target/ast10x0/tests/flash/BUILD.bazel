load("@pigweed//pw_kernel/tooling:system_image.bzl", "system_image")
load("@pigweed//pw_kernel/tooling:target_linker_script.bzl", "target_linker_script")
load("@pigweed//pw_kernel/tooling/panic_detector:rust_binary_no_panics_test.bzl", "rust_binary_no_panics_test")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//target/ast10x0:defs.bzl", "TARGET_COMPATIBLE_WITH")

filegroup(
    name = "system_config_fmc_derived_read",
    srcs = ["system_fmc_derived_read.json5"],
    visibility = ["//visibility:public"],
)

target_linker_script(
    name = "linker_script_fmc_derived_read",
    system_config = ":system_config_fmc_derived_read",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    template = "//target/ast10x0:linker_script_template",
)

rust_binary(
    name = "target_fmc_derived_read",
    srcs = [
        "target_fmc_derived_read.rs",
        "//target/ast10x0/tests/smc:target_debug.rs",
    ],
    edition = "2024",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        ":linker_script_fmc_derived_read",
        "//target/ast10x0:entry",
        "//target/ast10x0/backend/flash:flash_backend_ast10x0",
        "//target/ast10x0/board:ast10x0_board",
        "//target/ast10x0/peripherals",
        "@pigweed//pw_kernel/arch/arm_cortex_m:arch_arm_cortex_m",
        "@pigweed//pw_kernel/kernel",
        "@pigweed//pw_kernel/subsys/console:console_backend",
        "@pigweed//pw_kernel/target:target_common",
        "@pigweed//pw_log/rust:pw_log",
    ],
)

system_image(
    name = "flash_fmc_derived_read_test",
    kernel = ":target_fmc_derived_read",
    platform = "//target/ast10x0",
    system_config = ":system_config_fmc_derived_read",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    userspace = False,
    visibility = ["//visibility:public"],
)

rust_binary_no_panics_test(
    name = "no_panics_fmc_derived_read_test",
    binary = ":flash_fmc_derived_read_test",
    tags = ["kernel"],
)
rust_binary(
    name = "target_fmc_cs1_erase_write_verify",
    srcs = ["target_fmc_cs1_erase_write_verify.rs"],
    edition = "2024",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        ":linker_script_fmc_derived_read",
        "//target/ast10x0:entry",
        "//target/ast10x0/backend/flash:flash_backend_ast10x0",
        "//target/ast10x0/board:ast10x0_board",
        "//target/ast10x0/peripherals",
        "@pigweed//pw_kernel/subsys/console:console_backend",
        "@pigweed//pw_kernel/target:target_common",
        "@pigweed//pw_log/rust:pw_log",
    ],
)

system_image(
    name = "flash_fmc_cs1_erase_write_verify_test",
    kernel = ":target_fmc_cs1_erase_write_verify",
    platform = "//target/ast10x0",
    system_config = ":system_config_fmc_derived_read",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    userspace = False,
    visibility = ["//visibility:public"],
)

rust_binary_no_panics_test(
    name = "no_panics_fmc_cs1_erase_write_verify_test",
    binary = ":flash_fmc_cs1_erase_write_verify_test",
    tags = ["kernel"],
)
